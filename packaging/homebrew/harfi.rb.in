# Homebrew cask for Harfi, filled in by scripts/package_release.sh and copied to the tap
# (Mustafa-Abbara/homebrew-harfi, Casks/harfi.rb). Install: brew install --cask mustafa-abbara/harfi/harfi
cask "harfi" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/Mustafa-Abbara/arabizi-keyboard/releases/download/v#{version}/Harfi-#{version}.zip"
  name "Harfi"
  desc "Private keyboard that turns Lebanese Arabizi into Arabic, on your Mac"
  homepage "https://github.com/Mustafa-Abbara/arabizi-keyboard"

  depends_on arch: :arm64
  depends_on macos: ">= :sonoma"

  input_method "ArabiziIME.app"

  # Downloads the model (resuming if the connection drops), puts it in the sandboxed engine and registers the app.
  postflight do
    system_command "#{Dir.home}/Library/Input Methods/ArabiziIME.app/Contents/Resources/harfi-setup.sh",
                   args: ["#{Dir.home}/Library/Input Methods/ArabiziIME.app"]
  end

  uninstall quit: "lb.aub.arabizi.inputmethod.ArabiziIME"

  zap trash: [
    "~/Library/Application Support/ArabiziKeyboard",
    "~/Library/Caches/Harfi",
    "~/Library/Preferences/lb.aub.arabizi.inputmethod.ArabiziIME.plist",
  ]

  caveats <<~EOS
    Turn Harfi on once: System Settings → Keyboard → Input Sources → Edit… → + → Arabic → Harfi.
    Then switch to it with Ctrl+Space.
  EOS
end
