# The team uses both macOS and Windows. Store text as LF so shell scripts
# and Swift sources behave the same on every machine and in CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings or diff them as text.
*.png  binary
*.jpg  binary
*.tiff binary
*.pdf  binary
*.gguf binary
*.sqlite binary
